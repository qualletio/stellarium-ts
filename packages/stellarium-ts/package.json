{
  "name": "stellarium-ts",
  "version": "0.14.0",
  "description": "A Stellarium Node in TypeScript.",
  "homepage": "https://github.com/qualletio/stellarium-ts#readme",
  "bugs": {
    "url": "https://github.com/qualletio/stellarium-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualletio/stellarium-ts.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepack": "pnpm build",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "test": "vitest --passWithNoTests --exclude 'dist/**'",
    "lint": "biome lint src",
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "decentralized",
    "stellarium",
    "requestscript"
  ],
  "author": "Christopher Poulsen <christopher.poulsen@quallet.io>",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "requestscript": "1.1.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  }
}
