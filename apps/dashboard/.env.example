# The operator API, including /v1. Read on the server only.
OPERATOR_URL=http://127.0.0.1:3001/v1
# The operator URL API clients use, shown on the API clients page. Defaults to OPERATOR_URL.
# PUBLIC_OPERATOR_URL=https://operator.stellarium.sh/v1
# Set to true when the operator has GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET, to offer GitHub sign-in.
GITHUB_SIGN_IN=false
# The Composer (Claude writing RequestScript) needs both. Each message is charged to the organization's balance.
# ANTHROPIC_API_KEY=sk-ant-...
# Shared with the operator's DASHBOARD_SERVICE_SECRET; compose sets local-only-dashboard-secret.
# DASHBOARD_SERVICE_SECRET=local-only-dashboard-secret
# Locally, compose nodes report container hostnames. Rewrites them to URLs this server can reach, as from=to pairs.
# NODE_URL_REWRITES=http://local-resource-node:3002=http://127.0.0.1:3002,http://local-caller-node:3003=http://127.0.0.1:3003
